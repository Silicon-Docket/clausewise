{
  "name": "clausewise-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Open source, self-hosted contract review and redlining.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tools",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "fixtures": "tsx tools/make-fixtures.ts",
    "clausewise": "tsx apps/cli/src/bin.ts",
    "eval": "tsx evals/src/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "docx": "^9.12.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
